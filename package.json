{
  "name": "claude-archive-close-tab",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.5.0",
  "icon": "images/icon.png",
  "extensionKind": [
    "ui"
  ],
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pocharlies/claude-archive-close-tab.git"
  },
  "bugs": {
    "url": "https://github.com/pocharlies/claude-archive-close-tab/issues"
  },
  "homepage": "https://github.com/pocharlies/claude-archive-close-tab",
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "tabs",
    "archive"
  ],
  "engines": {
    "vscode": "^1.94.0"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce@3 package --no-dependencies"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeArchiveCloseTab.openSettings",
        "title": "%command.openSettings%",
        "category": "Claude Archive Close Tab",
        "icon": "$(settings-gear)"
      },
      {
        "command": "claudeArchiveCloseTab.showLog",
        "title": "%command.showLog%",
        "category": "Claude Archive Close Tab",
        "icon": "$(output)"
      }
    ],
    "configuration": {
      "title": "Claude Archive Close Tab",
      "properties": {
        "claudeArchiveCloseTab.enabled": {
          "type": "boolean",
          "default": true,
          "order": 0,
          "markdownDescription": "%config.enabled%"
        },
        "claudeArchiveCloseTab.evenEditorWidths": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "markdownDescription": "%config.evenEditorWidths%"
        },
        "claudeArchiveCloseTab.notifications": {
          "type": "string",
          "enum": [
            "off",
            "statusBar",
            "notification"
          ],
          "enumDescriptions": [
            "%config.notifications.off%",
            "%config.notifications.statusBar%",
            "%config.notifications.notification%"
          ],
          "default": "off",
          "order": 2,
          "markdownDescription": "%config.notifications%"
        },
        "claudeArchiveCloseTab.skipPinnedTabs": {
          "type": "boolean",
          "default": false,
          "order": 3,
          "markdownDescription": "%config.skipPinnedTabs%"
        },
        "claudeArchiveCloseTab.recentLabelSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "order": 4,
          "markdownDescription": "%config.recentLabelSeconds%"
        },
        "claudeArchiveCloseTab.safetyNetSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "order": 5,
          "markdownDescription": "%config.safetyNetSeconds%"
        },
        "claudeArchiveCloseTab.sqlitePath": {
          "type": "string",
          "default": "/usr/bin/sqlite3",
          "scope": "machine",
          "order": 6,
          "markdownDescription": "%config.sqlitePath%"
        }
      }
    }
  }
}
